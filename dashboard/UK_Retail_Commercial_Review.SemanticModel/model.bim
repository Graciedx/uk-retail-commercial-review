{
 "compatibilityLevel": 1550,
 "model": {
  "culture": "en-GB",
  "dataAccessOptions": {
   "legacyRedirects": true,
   "returnErrorValuesAsNull": true
  },
  "defaultPowerBIDataSourceVersion": "powerBI_V3",
  "sourceQueryCulture": "en-GB",
  "tables": [
   {
    "name": "mart_kpi_year",
    "columns": [
     {
      "name": "trading_year",
      "dataType": "string",
      "sourceColumn": "trading_year",
      "summarizeBy": "none"
     },
     {
      "name": "gross_sales",
      "dataType": "double",
      "sourceColumn": "gross_sales",
      "summarizeBy": "none"
     },
     {
      "name": "returns_value",
      "dataType": "double",
      "sourceColumn": "returns_value",
      "summarizeBy": "none"
     },
     {
      "name": "net_sales",
      "dataType": "double",
      "sourceColumn": "net_sales",
      "summarizeBy": "none"
     },
     {
      "name": "orders",
      "dataType": "int64",
      "sourceColumn": "orders",
      "summarizeBy": "none"
     },
     {
      "name": "identified_customers",
      "dataType": "int64",
      "sourceColumn": "identified_customers",
      "summarizeBy": "none"
     },
     {
      "name": "avg_order_value",
      "dataType": "double",
      "sourceColumn": "avg_order_value",
      "summarizeBy": "none"
     },
     {
      "name": "sales_no_customer_id",
      "dataType": "double",
      "sourceColumn": "sales_no_customer_id",
      "summarizeBy": "none"
     },
     {
      "name": "sales_with_customer_id",
      "dataType": "double",
      "sourceColumn": "sales_with_customer_id",
      "summarizeBy": "none"
     },
     {
      "name": "net_sales_with_customer_id",
      "dataType": "double",
      "sourceColumn": "net_sales_with_customer_id",
      "summarizeBy": "none"
     },
     {
      "name": "sales_sep_to_nov",
      "dataType": "double",
      "sourceColumn": "sales_sep_to_nov",
      "summarizeBy": "none"
     }
    ],
    "partitions": [
     {
      "name": "mart_kpi_year",
      "mode": "import",
      "source": {
       "type": "m",
       "expression": [
        "let",
        "    Source = Csv.Document(File.Contents(DataFolder & \"mart_kpi_year.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
        "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
        "    Typed = Table.TransformColumnTypes(Promoted, {{\"trading_year\", type text}, {\"gross_sales\", type number}, {\"returns_value\", type number}, {\"net_sales\", type number}, {\"orders\", Int64.Type}, {\"identified_customers\", Int64.Type}, {\"avg_order_value\", type number}, {\"sales_no_customer_id\", type number}, {\"sales_with_customer_id\", type number}, {\"net_sales_with_customer_id\", type number}, {\"sales_sep_to_nov\", type number}}, \"en-GB\")",
        "in",
        "    Typed"
       ]
      }
     }
    ],
    "measures": [
     {
      "name": "Net sales Y2",
      "expression": "CALCULATE(SUM(mart_kpi_year[net_sales]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\")/1000000",
      "formatString": "\u00a30.00\"m\""
     },
     {
      "name": "Net sales growth",
      "expression": "DIVIDE(CALCULATE(SUM(mart_kpi_year[net_sales]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\"),CALCULATE(SUM(mart_kpi_year[net_sales]),mart_kpi_year[trading_year]=\"Y1 (Dec09-Nov10)\"))-1",
      "formatString": "+0.0%;-0.0%"
     },
     {
      "name": "Identified customer sales change",
      "expression": "DIVIDE(CALCULATE(SUM(mart_kpi_year[net_sales_with_customer_id]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\"),CALCULATE(SUM(mart_kpi_year[net_sales_with_customer_id]),mart_kpi_year[trading_year]=\"Y1 (Dec09-Nov10)\"))-1",
      "formatString": "+0.0%;-0.0%"
     },
     {
      "name": "Share of sales with no customer ID",
      "expression": "DIVIDE(CALCULATE(SUM(mart_kpi_year[sales_no_customer_id]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\"),CALCULATE(SUM(mart_kpi_year[gross_sales]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\"))",
      "formatString": "0.0%"
     },
     {
      "name": "Return rate Y2",
      "expression": "DIVIDE(CALCULATE(SUM(mart_kpi_year[returns_value]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\"),CALCULATE(SUM(mart_kpi_year[gross_sales]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\"))",
      "formatString": "0.0%"
     },
     {
      "name": "Sep to Nov share of sales",
      "expression": "DIVIDE(CALCULATE(SUM(mart_kpi_year[sales_sep_to_nov]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\"),CALCULATE(SUM(mart_kpi_year[gross_sales]),mart_kpi_year[trading_year]=\"Y2 (Dec10-Nov11)\"))",
      "formatString": "0.0%"
     }
    ]
   },
