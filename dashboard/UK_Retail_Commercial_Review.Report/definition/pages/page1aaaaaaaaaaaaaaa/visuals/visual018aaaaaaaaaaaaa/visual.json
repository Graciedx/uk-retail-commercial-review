  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Recommendations",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Give the top 200 accounts named owners. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "They were 47% of known Y1 sales and 106 of them fell by more than 25%. Their \u00a31.14m gross decline is 37% of all lost and shrinking revenue.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "normal",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Capture a customer ID on every order. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "\u00a31.41m of Y2 sales, 15%, cannot be tied to a customer, and it made up all of the growth.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "normal",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Run a 90-day second-order programme. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Buyers who reorder inside 90 days spend about 3x more over 12 months, at the median. Raising the rate from 39% to 45% is worth up to about \u00a3100k a year if that gap is causal.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "normal",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Leave returns alone for now. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "At 2.4% of sales, they are a product-level fix, not a business priority.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "normal",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
